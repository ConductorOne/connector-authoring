{
  "openapi": "3.0.3",
  "info": {
    "title": "Directory API Fixture",
    "version": "1.0.0",
    "description": "Deterministic Directory API fixture for the connector-authoring eval harness. /v1/* uses basic auth + offset pagination; /v2/* uses bearer auth + Link-header pagination. Deliberate traps: (a) GET /v1/users without the required account_id scoping param returns only the 3-row unscoped subset; (b) user.title is nullable; (c) a replayed grant POST returns 200 with X-Idempotency-Replay: true."
  },
  "paths": {
    "/openapi.json": {
      "get": {
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "The OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users": {
      "get": {
        "summary": "List users (offset pagination, basic auth)",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "description": "Required scoping param. When missing, only the 3-row unscoped subset is returned (under-sync trap).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid basic auth"
          }
        }
      }
    },
    "/v1/groups": {
      "get": {
        "summary": "List groups (offset pagination, basic auth)",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of groups",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid basic auth"
          }
        }
      }
    },
    "/v1/groups/{groupId}/members": {
      "get": {
        "summary": "List group members (offset pagination, basic auth)",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of memberships",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid basic auth"
          },
          "404": {
            "description": "Unknown group"
          }
        }
      },
      "post": {
        "summary": "Add a group member (idempotent)",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Membership"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Membership added"
          },
          "200": {
            "description": "Membership already existed (replay)",
            "headers": {
              "X-Idempotency-Replay": {
                "description": "Set to true when the membership already existed",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Unknown user or malformed body"
          },
          "401": {
            "description": "Missing or invalid basic auth"
          }
        }
      }
    },
    "/v1/groups/{groupId}/members/{userId}": {
      "delete": {
        "summary": "Remove a group member (idempotent)",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Membership removed (or already absent)"
          },
          "401": {
            "description": "Missing or invalid basic auth"
          }
        }
      }
    },
    "/v2/users": {
      "get": {
        "summary": "List users (Link-header pagination, bearer auth)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bare array of users; Link rel=\"next\" header present on non-final pages",
            "headers": {
              "Link": {
                "description": "Pagination link to the next page (absent on the final page)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DirectoryUser"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer auth"
          }
        }
      }
    },
    "/v2/groups": {
      "get": {
        "summary": "List groups (Link-header pagination, bearer auth)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bare array of groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DirectoryGroup"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer auth"
          }
        }
      }
    },
    "/v2/groups/{groupId}/members": {
      "get": {
        "summary": "List group members (Link-header pagination, bearer auth)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bare array of memberships",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Membership"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer auth"
          },
          "404": {
            "description": "Unknown group"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "DirectoryUser": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nullable job title (projection trap)"
          }
        }
      },
      "DirectoryGroup": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": [
          "userId"
        ],
        "properties": {
          "userId": {
            "type": "string"
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "items",
          "offset",
          "limit",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {}
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      }
    }
  }
}
