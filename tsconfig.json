{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@baton/types": [
        "./baton/types.d.ts"
      ],
      "@baton/helpers": [
        "./baton/helpers.d.ts"
      ],
      "@baton/runtime": [
        "./baton/runtime.d.ts"
      ]
    },
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "baton/**/*.d.ts",
    "examples/**/*.ts"
  ]
}
